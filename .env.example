TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_OWNER_ID=123456789
TELEGRAM_ALLOWED_IDS=123456789,987654321
OPENAI_API_KEY=replace-me
# Optional: when set, Gemini takes priority and an OpenAI key is not required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional GapGPT API: checked first; existing Gemini and Cloudflare remain fallbacks.
GAPGPT_API_KEY=
GAPGPT_TEXT_MODEL=gpt-5.6-sol
GAPGPT_IMAGE_MODEL=gpt-image-2
GAPGPT_TRANSCRIPTION_MODEL=whisper-1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WEBHOOK_SECRET=replace-with-a-long-random-string
# Automatically supplied on Render. Required for webhook mode elsewhere.
RENDER_EXTERNAL_URL=https://your-service.example.com
OPENAI_MODEL=gpt-6.2-astra
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
